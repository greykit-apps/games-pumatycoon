.DS_Store

# Source material. Local only — never tracked, never pushed. Both spellings,
# so neither one can slip past `git add -A`.
source/
sources/

# Design context for local tooling. Kept on disk, not published.
.impeccable.md
# .claude/ is local, except the skills a cloud session needs (games-meta STANDARD.md §12).
# Last in the file so no rule above can hide part of a skill.
!.claude/
.claude/*
!.claude/skills/
!.claude/skills/**
.claude/skills/**/.DS_Store
